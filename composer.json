{
    "name": "hamzi/corewatch",
    "description": "Production-ready embedded DevOps dashboard for Laravel — server metrics, log streaming, safe ops panel, and alerting without external daemons.",
    "keywords": ["laravel", "devops", "monitoring", "server-health", "dashboard", "log-viewer", "alerts", "filament", "livewire", "server-monitoring", "uptime"],
    "homepage": "https://github.com/hamdyelbatal122/CoreWatch",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/hamdyelbatal122/CoreWatch/issues",
        "source": "https://github.com/hamdyelbatal122/CoreWatch"
    },
    "authors": [
        {
            "name": "Hamzi",
            "email": "hamdyelbatal122@hamzi.dev"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/pint": "^1.15",
        "larastan/larastan": "^3.0",
        "livewire/livewire": "^3.4 || ^4.0"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "suggest": {
        "livewire/livewire": "Allows embedding the reactive CoreWatch dashboard inside Filament, Nova, or custom Livewire admin templates."
    },
    "autoload": {
        "psr-4": {
            "Hamzi\\CoreWatch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hamzi\\CoreWatch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hamzi\\CoreWatch\\CoreWatchServiceProvider"
            ],
            "aliases": {
                "CoreWatch": "Hamzi\\CoreWatch\\Facades\\CoreWatch"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
